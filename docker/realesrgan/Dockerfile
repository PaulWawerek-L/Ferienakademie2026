# syntax=docker/dockerfile:1.7
# Project 05: Super Resolution -- Real-ESRGAN (xinntao/Real-ESRGAN).
ARG BASE_IMAGE=ferienakademie/base:cpu
FROM ${BASE_IMAGE}

RUN git clone --depth 1 https://github.com/xinntao/Real-ESRGAN.git /opt/Real-ESRGAN

# --no-deps is load-bearing. basicsr's own dependency list pulls in
#   * numpy<2, which breaks the base image's opencv-python-headless and contourpy
#     (both require numpy>=2), and
#   * opencv-python (non-headless), which then fights the headless build already
#     installed and drags in libGL.
# Installing its real runtime needs explicitly keeps the base image consistent.
# gfpgan/facexlib are left out too: they serve only the optional --face_enhance
# path, which this course does not use.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --retries 10 --timeout 120 --no-deps \
        "basicsr==1.4.2" \
 && pip install --retries 10 --timeout 120 \
        addict lmdb pyyaml yapf future requests scikit-image

# LPIPS: a perceptual metric, for the experiment that explains why PSNR and the
# eye disagree on GAN-based super-resolution. It downloads a small AlexNet on
# first use, into the mounted weights/ cache.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --retries 10 --timeout 120 lpips

COPY patch-basicsr.sh /tmp/patch-basicsr.sh
RUN bash /tmp/patch-basicsr.sh

# Real-ESRGAN must be installed, not just put on PYTHONPATH: realesrgan/__init__.py
# imports .version, and that file is generated by setup.py at install time from
# the VERSION file. --no-deps for the same reason as basicsr above.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps -e /opt/Real-ESRGAN \
 && python -c "from realesrgan import RealESRGANer; from basicsr.archs.rrdbnet_arch import RRDBNet; print('realesrgan + basicsr import OK')"

# Sanity-check that the base image's numpy/opencv were left alone.
RUN python -c "import numpy, cv2, torch; print('numpy', numpy.__version__, '| cv2', cv2.__version__, '| torch', torch.__version__)"

ENV PYTHONPATH=/opt/Real-ESRGAN
WORKDIR /work
CMD ["/bin/bash"]
